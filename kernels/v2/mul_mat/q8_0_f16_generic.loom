config.decl @shape.mul_mat_q8_0_f16_generic.k : %value: index where [range(%value, 32, 32768), mul(%value, 32)]
config.decl @shape.mul_mat_q8_0_f16_generic.rows : %value: index where [range(%value, 1, 262144)]
