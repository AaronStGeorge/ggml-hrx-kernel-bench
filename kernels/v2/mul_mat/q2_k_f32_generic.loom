config.decl @shape.mul_mat_q2_k_f32_generic.k : %value: index where [range(%value, 256, 32768), mul(%value, 256)]
config.decl @shape.mul_mat_q2_k_f32_generic.rows : %value: index where [range(%value, 1, 262144)]
config.decl @shape.mul_mat_q2_k_f32_generic.cols : %value: index where [range(%value, 1, 4096)]
config.decl @shape.mul_mat_q2_k_f32_generic.dst_ne2 : %value: index where [range(%value, 1, 4096)]
config.decl @shape.mul_mat_q2_k_f32_generic.dst_ne3 : %value: index where [range(%value, 1, 4096)]
config.decl @shape.mul_mat_q2_k_f32_generic.src0_ne2 : %value: index where [range(%value, 1, 4096)]
config.decl @shape.mul_mat_q2_k_f32_generic.src0_ne3 : %value: index where [range(%value, 1, 4096)]
config.decl @shape.mul_mat_q2_k_f32_generic.src0_stride_row : %value: index where [range(%value, 256, 1073741824), mul(%value, 256)]
config.decl @shape.mul_mat_q2_k_f32_generic.src0_stride_ne2 : %value: index where [range(%value, 256, 1073741824), mul(%value, 256)]
config.decl @shape.mul_mat_q2_k_f32_generic.src0_stride_ne3 : %value: index where [range(%value, 256, 1073741824), mul(%value, 256)]
config.decl @shape.mul_mat_q2_k_f32_generic.src1_stride_col : %value: index where [range(%value, 1, 104857600)]
config.decl @shape.mul_mat_q2_k_f32_generic.src1_stride_ne2 : %value: index where [range(%value, 1, 104857600)]
config.decl @shape.mul_mat_q2_k_f32_generic.src1_stride_ne3 : %value: index where [range(%value, 1, 104857600)]
config.decl @shape.mul_mat_q2_k_f32_generic.dst_stride_col : %value: index where [range(%value, 1, 104857600)]
config.decl @shape.mul_mat_q2_k_f32_generic.dst_stride_ne2 : %value: index where [range(%value, 1, 104857600)]
config.decl @shape.mul_mat_q2_k_f32_generic.dst_stride_ne3 : %value: index where [range(%value, 1, 104857600)]
config.decl @tuning.mul_mat_q2_k_f32_generic.workgroup_size : %value: index where [range(%value, 32, 256), mul(%value, 32)]

kernel.def export("hrx2_mul_mat_q2_k_f32_generic") @hrx2_mul_mat_q2_k_f32_generic() {
  %unit = index.constant 1 : index
  %rows = config.get @shape.mul_mat_q2_k_f32_generic.rows : index
  %cols = config.get @shape.mul_mat_q2_k_f32_generic.cols : index
  %dst_ne2 = config.get @shape.mul_mat_q2_k_f32_generic.dst_ne2 : index
  %dst_ne3 = config.get @shape.mul_mat_q2_k_f32_generic.dst_ne3 : index
  %workgroup_size = config.get @tuning.mul_mat_q2_k_f32_generic.workgroup_size : index
  %outer0 = index.mul %cols, %dst_ne2 : index
  %outer = index.mul %outer0, %dst_ne3 : index
  kernel.launch.config workgroups(%rows, %outer, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%src0: buffer, %src1: buffer, %dst: buffer) {
  %base = index.constant 0 : offset
  %zero_index = index.constant 0 : index
  %unit = index.constant 1 : index
  %two = index.constant 2 : index
  %eight = index.constant 8 : index
  %sixteen = index.constant 16 : index
  %thirtytwo = index.constant 32 : index
  %forty = index.constant 40 : index
  %fortyone = index.constant 41 : index
  %onetwentyeight = index.constant 128 : index
  %qk = index.constant 256 : index
  %block_bytes = index.constant 84 : index
  %block_f16s = index.constant 42 : index
  %qs_offset = index.constant 16 : index
  %two_i32 = scalar.constant 2 : i32
  %four_i32 = scalar.constant 4 : i32
  %mask_0f = scalar.constant 15 : i32
  %mask_03 = scalar.constant 3 : i32
  %zero_f32 = scalar.constant 0.0 : f32

  %k = config.get @shape.mul_mat_q2_k_f32_generic.k : index
  %rows = config.get @shape.mul_mat_q2_k_f32_generic.rows : index
  %cols = config.get @shape.mul_mat_q2_k_f32_generic.cols : index
  %dst_ne2 = config.get @shape.mul_mat_q2_k_f32_generic.dst_ne2 : index
  %dst_ne3 = config.get @shape.mul_mat_q2_k_f32_generic.dst_ne3 : index
  %src0_ne2 = config.get @shape.mul_mat_q2_k_f32_generic.src0_ne2 : index
  %src0_ne3 = config.get @shape.mul_mat_q2_k_f32_generic.src0_ne3 : index
  %src0_stride_row = config.get @shape.mul_mat_q2_k_f32_generic.src0_stride_row : index
  %src0_stride_ne2 = config.get @shape.mul_mat_q2_k_f32_generic.src0_stride_ne2 : index
  %src0_stride_ne3 = config.get @shape.mul_mat_q2_k_f32_generic.src0_stride_ne3 : index
  %src1_stride_col = config.get @shape.mul_mat_q2_k_f32_generic.src1_stride_col : index
  %src1_stride_ne2 = config.get @shape.mul_mat_q2_k_f32_generic.src1_stride_ne2 : index
  %src1_stride_ne3 = config.get @shape.mul_mat_q2_k_f32_generic.src1_stride_ne3 : index
  %dst_stride_col = config.get @shape.mul_mat_q2_k_f32_generic.dst_stride_col : index
  %dst_stride_ne2 = config.get @shape.mul_mat_q2_k_f32_generic.dst_stride_ne2 : index
  %dst_stride_ne3 = config.get @shape.mul_mat_q2_k_f32_generic.dst_stride_ne3 : index
  %workgroup_size = config.get @tuning.mul_mat_q2_k_f32_generic.workgroup_size : index

  %row = kernel.workgroup.id<x> : index
  %outer = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %col = index.rem %outer, %cols : index
  %batch_linear = index.div %outer, %cols : index
  %i2 = index.rem %batch_linear, %dst_ne2 : index
  %i3 = index.div %batch_linear, %dst_ne2 : index
  %src0_scale2 = index.div %dst_ne2, %src0_ne2 : index
  %src0_i2 = index.div %i2, %src0_scale2 : index
  %src0_scale3 = index.div %dst_ne3, %src0_ne3 : index
  %src0_i3 = index.div %i3, %src0_scale3 : index

  %last_row = index.sub %rows, %unit : index
  %src0_last_row_off = index.mul %last_row, %src0_stride_row : index
  %src0_last_i2 = index.sub %src0_ne2, %unit : index
  %src0_last_i2_off = index.mul %src0_last_i2, %src0_stride_ne2 : index
  %src0_last_i3 = index.sub %src0_ne3, %unit : index
  %src0_last_i3_off = index.mul %src0_last_i3, %src0_stride_ne3 : index
  %src0_last_0 = index.add %src0_last_row_off, %src0_last_i2_off : index
  %src0_last = index.add %src0_last_0, %src0_last_i3_off : index
  %src0_logical_count = index.add %src0_last, %k : index
  %src0_blocks = index.div %src0_logical_count, %qk : index
  %src0_i8_count = index.mul %src0_blocks, %block_bytes : index
  %src0_f16_count = index.mul %src0_blocks, %block_f16s : index

  %last_col = index.sub %cols, %unit : index
  %src1_last_col_off = index.mul %last_col, %src1_stride_col : index
  %last_i2 = index.sub %dst_ne2, %unit : index
  %src1_last_i2_off = index.mul %last_i2, %src1_stride_ne2 : index
  %last_i3 = index.sub %dst_ne3, %unit : index
  %src1_last_i3_off = index.mul %last_i3, %src1_stride_ne3 : index
  %src1_last_0 = index.add %src1_last_col_off, %src1_last_i2_off : index
  %src1_last = index.add %src1_last_0, %src1_last_i3_off : index
  %src1_count = index.add %src1_last, %k : index

  %dst_last_col_off = index.mul %last_col, %dst_stride_col : index
  %dst_last_i2_off = index.mul %last_i2, %dst_stride_ne2 : index
  %dst_last_i3_off = index.mul %last_i3, %dst_stride_ne3 : index
  %dst_last_0 = index.add %last_row, %dst_last_col_off : index
  %dst_last_1 = index.add %dst_last_0, %dst_last_i2_off : index
  %dst_last = index.add %dst_last_1, %dst_last_i3_off : index
  %dst_count = index.add %dst_last, %unit : index

  %src0_global = buffer.assume.memory_space<descriptor> %src0 : buffer
  %src1_global = buffer.assume.memory_space<descriptor> %src1 : buffer
  %dst_global = buffer.assume.memory_space<descriptor> %dst : buffer
  %src0_noalias, %src1_noalias, %dst_noalias = buffer.assume.noalias %src0_global, %src1_global, %dst_global : buffer, buffer, buffer
  %src0_i8_view = buffer.view %src0_noalias[%base] : buffer -> view<[%src0_i8_count]xi8, #dense>
  %src0_f16_view = buffer.view %src0_noalias[%base] : buffer -> view<[%src0_f16_count]xf16, #dense>
  %src1_view = buffer.view %src1_noalias[%base] : buffer -> view<[%src1_count]xf32, #dense>
  %dst_view = buffer.view %dst_noalias[%base] : buffer -> view<[%dst_count]xf32, #dense>

  %src0_row_off = index.mul %row, %src0_stride_row : index
  %src0_i2_off = index.mul %src0_i2, %src0_stride_ne2 : index
  %src0_i3_off = index.mul %src0_i3, %src0_stride_ne3 : index
  %src0_base0 = index.add %src0_row_off, %src0_i2_off : index
  %src0_base_logical = index.add %src0_base0, %src0_i3_off : index
  %src1_col_off = index.mul %col, %src1_stride_col : index
  %src1_i2_off = index.mul %i2, %src1_stride_ne2 : index
  %src1_i3_off = index.mul %i3, %src1_stride_ne3 : index
  %src1_base0 = index.add %src1_col_off, %src1_i2_off : index
  %src1_base = index.add %src1_base0, %src1_i3_off : index

  %sum = scf.for %ki = [%lane to %k step %workgroup_size](%acc = %zero_f32 : f32) -> (f32) {
    %src0_offset = index.add %src0_base_logical, %ki : index
    %linear_block = index.div %src0_offset, %qk : index
    %block_byte_base = index.mul %linear_block, %block_bytes : index
    %block_f16_base = index.mul %linear_block, %block_f16s : index
    %in_block = index.rem %src0_offset, %qk : index
    %in_half = index.div %in_block, %onetwentyeight : index
    %within_half = index.rem %in_block, %onetwentyeight : index
    %group_in_half = index.div %within_half, %sixteen : index
    %group_pair = index.rem %group_in_half, %two : index
    %pos_in_group = index.rem %within_half, %sixteen : index
    %half_qs_base = index.mul %in_half, %thirtytwo : index
    %pair_qs_base = index.mul %group_pair, %sixteen : index
    %qs_byte0 = index.add %half_qs_base, %pair_qs_base : index
    %qs_byte = index.add %qs_byte0, %pos_in_group : index
    %scale_half_base = index.mul %in_half, %eight : index
    %scale_idx = index.add %scale_half_base, %group_in_half : index
    %scale_index = index.add %block_byte_base, %scale_idx : index
    %qs_payload = index.add %block_byte_base, %qs_offset : index
    %q_index = index.add %qs_payload, %qs_byte : index
    %d_index = index.add %block_f16_base, %forty : index
    %dmin_index = index.add %block_f16_base, %fortyone : index
    %d_f16 = view.load %src0_f16_view[%d_index] : view<[%src0_f16_count]xf16, #dense> -> f16
    %dmin_f16 = view.load %src0_f16_view[%dmin_index] : view<[%src0_f16_count]xf16, #dense> -> f16
    %d = scalar.extf %d_f16 : f16 to f32
    %dmin = scalar.extf %dmin_f16 : f16 to f32
    %scale_i8 = view.load %src0_i8_view[%scale_index] : view<[%src0_i8_count]xi8, #dense> -> i8
    %scale_u32 = scalar.extui %scale_i8 : i8 to i32
    %scale_i32 = scalar.andi %scale_u32, %mask_0f : i32
    %min_i32 = scalar.shrui %scale_u32, %four_i32 : i32
    %packed_i8 = view.load %src0_i8_view[%q_index] : view<[%src0_i8_count]xi8, #dense> -> i8
    %packed_i32 = scalar.extui %packed_i8 : i8 to i32
    %shift_group = index.div %group_in_half, %two : index
    %shift_group_i32 = index.cast %shift_group : index to i32
    %shift = scalar.muli %shift_group_i32, %two_i32 : i32
    %q_shifted = scalar.shrui %packed_i32, %shift : i32
    %q_i32 = scalar.andi %q_shifted, %mask_03 : i32
    %q_f32 = scalar.uitofp %q_i32 : i32 to f32
    %scale_f32 = scalar.uitofp %scale_i32 : i32 to f32
    %min_f32 = scalar.uitofp %min_i32 : i32 to f32
    %src1_index = index.add %src1_base, %ki : index
    %rhs = view.load %src1_view[%src1_index] : view<[%src1_count]xf32, #dense> -> f32
    %scaled = scalar.mulf<reassoc|nnan|ninf|nsz> %d, %scale_f32 : f32
    %minimum = scalar.mulf<reassoc|nnan|ninf|nsz> %dmin, %min_f32 : f32
    %weighted = scalar.mulf<reassoc|nnan|ninf|nsz> %scaled, %q_f32 : f32
    %dequant = scalar.subf<reassoc|nnan|ninf|nsz> %weighted, %minimum : f32
    %product = scalar.mulf<reassoc|nnan|ninf|nsz> %dequant, %rhs : f32
    %next = scalar.addf<reassoc|nnan|ninf|nsz> %acc, %product : f32
    scf.yield %next : f32
  }

  %dot = kernel.workgroup.reduce<addf> %sum : f32
  %lane0 = index.cmp eq, %lane, %zero_index : index
  scf.if %lane0 {
    %dst_col_off = index.mul %col, %dst_stride_col : index
    %dst_i2_off = index.mul %i2, %dst_stride_ne2 : index
    %dst_i3_off = index.mul %i3, %dst_stride_ne3 : index
    %dst_index0 = index.add %row, %dst_col_off : index
    %dst_index1 = index.add %dst_index0, %dst_i2_off : index
    %dst_index = index.add %dst_index1, %dst_i3_off : index
    view.store %dot, %dst_view[%dst_index] : f32, view<[%dst_count]xf32, #dense>
  }
  kernel.return
}
