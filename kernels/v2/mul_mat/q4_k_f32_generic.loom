config.decl @shape.mul_mat_q4_k_f32_generic.k : %value: index where [range(%value, 256, 32768), mul(%value, 256)]
config.decl @shape.mul_mat_q4_k_f32_generic.rows : %value: index where [range(%value, 1, 32768)]
config.decl @shape.mul_mat_q4_k_f32_generic.cols : %value: index where [range(%value, 1, 1024)]
