config.decl @tuning.mul_mat_q4_k_f32_generic.workgroup_size : %value: index where [range(%value, 64, 256), mul(%value, 64)]

kernel.def export("hrx2_mul_mat_q4_k_f32_generic") @hrx2_mul_mat_q4_k_f32_generic() {
  %unit = index.constant 1 : index
  %qk = index.constant 256 : index
  %k = config.get @shape.mul_mat_q4_k_f32_generic.k : index
  %rows = config.get @shape.mul_mat_q4_k_f32_generic.rows : index
  %cols = config.get @shape.mul_mat_q4_k_f32_generic.cols : index
  %dst_ne2 = config.get @shape.mul_mat_q4_k_f32_generic.dst_ne2 : index
  %dst_ne3 = config.get @shape.mul_mat_q4_k_f32_generic.dst_ne3 : index
  %workgroup_size = config.get @tuning.mul_mat_q4_k_f32_generic.workgroup_size : index
  %blocks_per_row = index.div %k, %qk : index
  %outer0 = index.mul %cols, %dst_ne2 : index
  %outer = index.mul %outer0, %dst_ne3 : index
  kernel.launch.config workgroups(%rows, %outer, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%src0: buffer, %src1: buffer, %dst: buffer) {
  %base = index.constant 0 : offset
  %zero_index = index.constant 0 : index
  %zero_i32 = scalar.constant 0 : i32
  %unit = index.constant 1 : index
  %two = index.constant 2 : index
  %four = index.constant 4 : index
  %eight = index.constant 8 : index
  %thirtytwo = index.constant 32 : index
  %sixtyfour = index.constant 64 : index
  %six_i32 = scalar.constant 6 : i32
  %four_i32 = scalar.constant 4 : i32
  %mask_0f = scalar.constant 15 : i32
  %mask_3f = scalar.constant 63 : i32
  %qk = index.constant 256 : index
  %block_bytes = index.constant 144 : index
  %block_f16s = index.constant 72 : index
  %scale_offset = index.constant 4 : index
  %qs_offset = index.constant 16 : index
  %zero_f32 = scalar.constant 0.0 : f32

  %k = config.get @shape.mul_mat_q4_k_f32_generic.k : index
  %rows = config.get @shape.mul_mat_q4_k_f32_generic.rows : index
  %cols = config.get @shape.mul_mat_q4_k_f32_generic.cols : index
  %dst_ne2 = config.get @shape.mul_mat_q4_k_f32_generic.dst_ne2 : index
  %dst_ne3 = config.get @shape.mul_mat_q4_k_f32_generic.dst_ne3 : index
  %src0_ne2 = config.get @shape.mul_mat_q4_k_f32_generic.src0_ne2 : index
  %src0_ne3 = config.get @shape.mul_mat_q4_k_f32_generic.src0_ne3 : index
  %src0_stride_row = config.get @shape.mul_mat_q4_k_f32_generic.src0_stride_row : index
  %src0_stride_ne2 = config.get @shape.mul_mat_q4_k_f32_generic.src0_stride_ne2 : index
  %src0_stride_ne3 = config.get @shape.mul_mat_q4_k_f32_generic.src0_stride_ne3 : index
  %src1_stride_col = config.get @shape.mul_mat_q4_k_f32_generic.src1_stride_col : index
  %src1_stride_ne2 = config.get @shape.mul_mat_q4_k_f32_generic.src1_stride_ne2 : index
  %src1_stride_ne3 = config.get @shape.mul_mat_q4_k_f32_generic.src1_stride_ne3 : index
  %dst_stride_col = config.get @shape.mul_mat_q4_k_f32_generic.dst_stride_col : index
  %dst_stride_ne2 = config.get @shape.mul_mat_q4_k_f32_generic.dst_stride_ne2 : index
  %dst_stride_ne3 = config.get @shape.mul_mat_q4_k_f32_generic.dst_stride_ne3 : index
  %workgroup_size = config.get @tuning.mul_mat_q4_k_f32_generic.workgroup_size : index
  %blocks_per_row = index.div %k, %qk : index

  %row = kernel.workgroup.id<x> : index
  %outer = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %col = index.rem %outer, %cols : index
  %batch_linear = index.div %outer, %cols : index
  %i2 = index.rem %batch_linear, %dst_ne2 : index
  %i3 = index.div %batch_linear, %dst_ne2 : index
  %src0_scale2 = index.div %dst_ne2, %src0_ne2 : index
  %src0_i2 = index.div %i2, %src0_scale2 : index
  %src0_scale3 = index.div %dst_ne3, %src0_ne3 : index
  %src0_i3 = index.div %i3, %src0_scale3 : index

  %last_row = index.sub %rows, %unit : index
  %src0_last_row_off = index.mul %last_row, %src0_stride_row : index
  %src0_last_i2 = index.sub %src0_ne2, %unit : index
  %src0_last_i2_off = index.mul %src0_last_i2, %src0_stride_ne2 : index
  %src0_last_i3 = index.sub %src0_ne3, %unit : index
  %src0_last_i3_off = index.mul %src0_last_i3, %src0_stride_ne3 : index
  %src0_last_0 = index.add %src0_last_row_off, %src0_last_i2_off : index
  %src0_last = index.add %src0_last_0, %src0_last_i3_off : index
  %src0_logical_count = index.add %src0_last, %k : index
  %src0_blocks = index.div %src0_logical_count, %qk : index
  %src0_i8_count = index.mul %src0_blocks, %block_bytes : index
  %src0_f16_count = index.mul %src0_blocks, %block_f16s : index

  %last_col = index.sub %cols, %unit : index
  %src1_last_col_off = index.mul %last_col, %src1_stride_col : index
  %last_i2 = index.sub %dst_ne2, %unit : index
  %src1_last_i2_off = index.mul %last_i2, %src1_stride_ne2 : index
  %last_i3 = index.sub %dst_ne3, %unit : index
  %src1_last_i3_off = index.mul %last_i3, %src1_stride_ne3 : index
  %src1_last_0 = index.add %src1_last_col_off, %src1_last_i2_off : index
  %src1_last = index.add %src1_last_0, %src1_last_i3_off : index
  %src1_count = index.add %src1_last, %k : index

  %dst_last_col_off = index.mul %last_col, %dst_stride_col : index
  %dst_last_i2_off = index.mul %last_i2, %dst_stride_ne2 : index
  %dst_last_i3_off = index.mul %last_i3, %dst_stride_ne3 : index
  %dst_last_0 = index.add %last_row, %dst_last_col_off : index
  %dst_last_1 = index.add %dst_last_0, %dst_last_i2_off : index
  %dst_last = index.add %dst_last_1, %dst_last_i3_off : index
  %dst_count = index.add %dst_last, %unit : index

  %block_lane = index.rem %lane, %sixtyfour : index
  %block_slot = index.div %lane, %sixtyfour : index
  %block_step = index.div %workgroup_size, %sixtyfour : index
  %group = index.div %block_lane, %eight : index
  %lane_in_group = index.rem %block_lane, %eight : index
  %lane_q = index.mul %lane_in_group, %four : index
  %group_half = index.div %group, %two : index
  %qs_group_base = index.mul %group_half, %thirtytwo : index
  %qs_lane_base = index.add %qs_group_base, %lane_q : index
  %group_parity = index.rem %group, %two : index
  %is_high_group = index.cmp eq, %group_parity, %unit : index

  %src0_global = buffer.assume.memory_space<descriptor> %src0 : buffer
  %src1_global = buffer.assume.memory_space<descriptor> %src1 : buffer
  %dst_global = buffer.assume.memory_space<descriptor> %dst : buffer
  %src0_noalias, %src1_noalias, %dst_noalias = buffer.assume.noalias %src0_global, %src1_global, %dst_global : buffer, buffer, buffer
  %src0_i8_view = buffer.view %src0_noalias[%base] : buffer -> view<[%src0_i8_count]xi8, #dense>
  %src0_f16_view = buffer.view %src0_noalias[%base] : buffer -> view<[%src0_f16_count]xf16, #dense>
  %src1_view = buffer.view %src1_noalias[%base] : buffer -> view<[%src1_count]xf32, #dense>
  %dst_view = buffer.view %dst_noalias[%base] : buffer -> view<[%dst_count]xf32, #dense>

  %src0_row_off = index.mul %row, %src0_stride_row : index
  %src0_i2_off = index.mul %src0_i2, %src0_stride_ne2 : index
  %src0_i3_off = index.mul %src0_i3, %src0_stride_ne3 : index
  %src0_base0 = index.add %src0_row_off, %src0_i2_off : index
  %src0_base_logical = index.add %src0_base0, %src0_i3_off : index
  %src0_base_block = index.div %src0_base_logical, %qk : index
  %src1_col_off = index.mul %col, %src1_stride_col : index
  %src1_i2_off = index.mul %i2, %src1_stride_ne2 : index
  %src1_i3_off = index.mul %i3, %src1_stride_ne3 : index
  %src1_base0 = index.add %src1_col_off, %src1_i2_off : index
  %src1_base = index.add %src1_base0, %src1_i3_off : index

  %sum = scf.for %block_idx = [%block_slot to %blocks_per_row step %block_step](%acc = %zero_f32 : f32) -> (f32) {
    %src_base_block = index.mul %block_idx, %qk : index
    %src_base_group = index.mul %group, %thirtytwo : index
    %src_base0 = index.add %src_base_block, %src_base_group : index
    %src_base = index.add %src_base0, %lane_q : index
    %linear_block = index.add %src0_base_block, %block_idx : index
    %block_byte_base = index.mul %linear_block, %block_bytes : index
    %block_f16_base = index.mul %linear_block, %block_f16s : index
    %dmin_index = index.add %block_f16_base, %unit : index
    %scale_base = index.add %block_byte_base, %scale_offset : index
    %qs_payload = index.add %block_byte_base, %qs_offset : index
    %qs_base = index.add %qs_payload, %qs_lane_base : index
    %d_f16 = view.load %src0_f16_view[%block_f16_base] : view<[%src0_f16_count]xf16, #dense> -> f16
    %dmin_f16 = view.load %src0_f16_view[%dmin_index] : view<[%src0_f16_count]xf16, #dense> -> f16
    %d0 = scalar.extf %d_f16 : f16 to f32
    %dmin0 = scalar.extf %dmin_f16 : f16 to f32
    %group_lt4 = index.cmp slt, %group, %four : index
    %scale_i32, %min_i32 = scf.if %group_lt4 -> (i32, i32) {
      %d_index = index.add %scale_base, %group : index
      %m_group = index.add %group, %four : index
      %m_index = index.add %scale_base, %m_group : index
      %d_i8 = view.load %src0_i8_view[%d_index] : view<[%src0_i8_count]xi8, #dense> -> i8
      %m_i8 = view.load %src0_i8_view[%m_index] : view<[%src0_i8_count]xi8, #dense> -> i8
      %d_u32 = scalar.extui %d_i8 : i8 to i32
      %m_u32 = scalar.extui %m_i8 : i8 to i32
      %d = scalar.andi %d_u32, %mask_3f : i32
      %m = scalar.andi %m_u32, %mask_3f : i32
      scf.yield %d, %m : i32, i32
    } else {
      %group_minus4 = index.sub %group, %four : index
      %group_plus4 = index.add %group, %four : index
      %low_index = index.add %scale_base, %group_minus4 : index
      %mid_index = index.add %scale_base, %group : index
      %high_index = index.add %scale_base, %group_plus4 : index
      %low_i8 = view.load %src0_i8_view[%low_index] : view<[%src0_i8_count]xi8, #dense> -> i8
      %mid_i8 = view.load %src0_i8_view[%mid_index] : view<[%src0_i8_count]xi8, #dense> -> i8
      %high_i8 = view.load %src0_i8_view[%high_index] : view<[%src0_i8_count]xi8, #dense> -> i8
      %low = scalar.extui %low_i8 : i8 to i32
      %mid = scalar.extui %mid_i8 : i8 to i32
      %high = scalar.extui %high_i8 : i8 to i32
      %scale_low = scalar.andi %high, %mask_0f : i32
      %scale_hi0 = scalar.shrui %low, %six_i32 : i32
      %scale_hi = scalar.shli %scale_hi0, %four_i32 : i32
      %d = scalar.ori %scale_low, %scale_hi : i32
      %min_low = scalar.shrui %high, %four_i32 : i32
      %min_hi0 = scalar.shrui %mid, %six_i32 : i32
      %min_hi = scalar.shli %min_hi0, %four_i32 : i32
      %m = scalar.ori %min_low, %min_hi : i32
      scf.yield %d, %m : i32, i32
    }
    %scale_f32 = scalar.uitofp %scale_i32 : i32 to f32
    %min_f32 = scalar.uitofp %min_i32 : i32 to f32
    %d = scalar.mulf<reassoc|nnan|ninf|nsz> %d0, %scale_f32 : f32
    %min = scalar.mulf<reassoc|nnan|ninf|nsz> %dmin0, %min_f32 : f32
    %next = scf.for %j = [%zero_index to %four step %unit](%inner = %acc : f32) -> (f32) {
      %q_index = index.add %qs_base, %j : index
      %src_offset = index.add %src_base, %j : index
      %src1_index = index.add %src1_base, %src_offset : index
      %q_i8 = view.load %src0_i8_view[%q_index] : view<[%src0_i8_count]xi8, #dense> -> i8
      %q_byte = scalar.extui %q_i8 : i8 to i32
      %q_i32 = scf.if %is_high_group -> (i32) {
        %hi = scalar.shrui %q_byte, %four_i32 : i32
        scf.yield %hi : i32
      } else {
        %lo = scalar.andi %q_byte, %mask_0f : i32
        scf.yield %lo : i32
      }
      %q_f32 = scalar.uitofp %q_i32 : i32 to f32
      %rhs = view.load %src1_view[%src1_index] : view<[%src1_count]xf32, #dense> -> f32
      %scaled = scalar.mulf<reassoc|nnan|ninf|nsz> %d, %q_f32 : f32
      %dequant = scalar.subf<reassoc|nnan|ninf|nsz> %scaled, %min : f32
      %product = scalar.mulf<reassoc|nnan|ninf|nsz> %dequant, %rhs : f32
      %acc_next = scalar.addf<reassoc|nnan|ninf|nsz> %inner, %product : f32
      scf.yield %acc_next : f32
    }
    scf.yield %next : f32
  }

  %dot = kernel.workgroup.reduce<addf> %sum : f32
  %lane0 = index.cmp eq, %lane, %zero_index : index
  scf.if %lane0 {
    %dst_col_off = index.mul %col, %dst_stride_col : index
    %dst_i2_off = index.mul %i2, %dst_stride_ne2 : index
    %dst_i3_off = index.mul %i3, %dst_stride_ne3 : index
    %dst_index0 = index.add %row, %dst_col_off : index
    %dst_index1 = index.add %dst_index0, %dst_i2_off : index
    %dst_index = index.add %dst_index1, %dst_i3_off : index
    view.store %dot, %dst_view[%dst_index] : f32, view<[%dst_count]xf32, #dense>
  }
  kernel.return
}
